# Sample environment variables for the backend
# Copy this file to `.env` and fill in secret values before running.

# Database: SQLite file or a standard database URL (Postgres/MySQL)
# Example (SQLite):
DATABASE_URL=sqlite:///AdventureWorksLT.db
# Example (Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# OpenAI API key (if using OpenAI provider)
OPENAI_API_KEY=

# GROQ API key (if using Groq provider)
GROQ_API_KEY=

# LLM provider and model settings
LLM_PROVIDER=openai or groq
MODEL_NAME=gpt-4o-mini or llama-3.3-70b-versatile
